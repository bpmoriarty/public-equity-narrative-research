# TEMPLATE — copy this file to `.env` and fill in real values.
#
#     cp .env.example .env        (Git Bash)
#     Copy-Item .env.example .env (PowerShell)
#
# `.env` is gitignored; this template is committed. Never put a real email
# address or API key in this file.

# REQUIRED. The SEC requires a descriptive User-Agent identifying who is making
# the request. Requests without one get blocked outright. Format is "Name email".
# edgartools reads this variable automatically.
EDGAR_IDENTITY="Your Name your.name@example.com"

# OPTIONAL, and unnecessary for most people. Needed ONLY if you switch
# config/llm.toml to `backend = "api"`. The default backend runs the model calls
# on a Claude seat through Claude Code and needs no key at all — which is the
# whole reason it is the default, since almost nobody here has one.
#
# Worth setting if you DO have a key: extraction measured about half the cost
# through the API as through the seat, and a single stage can be moved across
# without touching the other. See the PER-STAGE OVERRIDES note in config/llm.toml.
# ANTHROPIC_API_KEY="sk-ant-..."

# OPTIONAL. edgartools' own cache location. Leave unset — this project manages
# its own cache in companies/<TICKER>/data/raw/ so a company's cached filings sit
# beside its config and deliverables rather than hidden in a home directory.
# EDGAR_LOCAL_DATA_DIR=""
